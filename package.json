{
  "name": "swalayaku-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run lint && npm run test:logic",
    "test:logic": "tsx scripts/test-logic.ts",
    "test:db": "tsx --tsconfig tsconfig.scripts.json scripts/test-db.ts",
    "test:purchase": "tsx --tsconfig tsconfig.scripts.json scripts/test-purchase.ts",
    "test:ledger": "tsx --tsconfig tsconfig.scripts.json scripts/test-ledger.ts",
    "test:sales": "tsx --tsconfig tsconfig.scripts.json scripts/test-sales.ts",
    "test:reports": "tsx --tsconfig tsconfig.scripts.json scripts/test-reports.ts",
    "test:inventory": "tsx --tsconfig tsconfig.scripts.json scripts/test-inventory.ts",
    "test:flows": "tsx --tsconfig tsconfig.scripts.json scripts/test-flows.ts",
    "test:boundary": "tsx --tsconfig tsconfig.scripts.json scripts/audit-client-boundary.ts",
    "test:routes": "tsx --tsconfig tsconfig.scripts.json scripts/audit-routes.ts",
    "test:http": "tsx --tsconfig tsconfig.scripts.json scripts/test-http.ts",
    "test:all": "npm run test && npm run test:db && npm run test:purchase && npm run test:ledger && npm run test:sales && npm run test:reports && npm run test:inventory && npm run test:routes && npm run test:boundary && npm run test:flows && npm run test:http",
    "verify": "npm run test:all && npm run build",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@prisma/adapter-neon": "^7.10.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.5",
    "jose": "^6.2.12",
    "lucide-react": "^1.52.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.7.0",
    "react": "19.2.8",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.89.0",
    "recharts": "^3.8.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prisma": "^7.10.0",
    "shadcn": "^4.21.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
