# ─────────────────────────────────────────────────────────────────────────────
# Swalayaku — Environment Configuration
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string (Neon recommended for Vercel).
# For Neon, use the POOLED connection string for serverless runtime
# (-pooler region) to avoid exhausting connections.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Secret used to sign session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Must be at least 32 characters.
AUTH_SECRET="replace-with-a-long-random-string"

# Public base URL, no trailing slash. Used for absolute URLs and metadata.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─────────────────────────────────────────────────────────────────────────────
# Image storage (optional — product images)
# Vercel Blob is the recommended option for Vercel deployments.
# Install: npm i @vercel/blob
# Set both BLOB_READ_WRITE_TOKEN and NEXT_PUBLIC_BLOB_ENABLED=true to enable
# uploads. When disabled, the UI accepts plain image URLs instead.
# ─────────────────────────────────────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=""
NEXT_PUBLIC_BLOB_ENABLED="false"